<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_frame"
    android:clipToOutline="true"
    tools:ignore="UnusedAttribute">

    <ImageView
        android:id="@+id/widget_backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.3"
                android:maxLines="1"
                android:text="@string/widget_kicker"
                android:textColor="#FF19F0FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/share_tech_mono"
                android:letterSpacing="0.1"
                android:text="@string/widget_sample_percent"
                android:textColor="#FFF4EEFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Three stacked copies make the chromatic-aberration title. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <TextView
                android:id="@+id/widget_steps_magenta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/roboto_black"
                android:gravity="center_vertical|start"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_sample_steps"
                android:textColor="#FFFF2D95" />

            <TextView
                android:id="@+id/widget_steps_cyan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/roboto_black"
                android:gravity="center_vertical|start"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_sample_steps"
                android:textColor="#FF19F0FF" />

            <TextView
                android:id="@+id/widget_steps"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="1.5dp"
                android:layout_marginTop="1dp"
                android:autoSizeMaxTextSize="64sp"
                android:autoSizeMinTextSize="20sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/roboto_black"
                android:gravity="center_vertical|start"
                android:maxLines="1"
                android:text="@string/widget_sample_steps"
                android:textColor="#FFFFF3FA" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_bold"
            android:letterSpacing="0.25"
            android:maxLines="1"
            android:text="@string/widget_sample_subtitle"
            android:textColor="#FFFFE81A"
            android:textSize="11sp" />

        <ProgressBar
            android:id="@+id/widget_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:max="1000"
            android:progress="810"
            android:progressDrawable="@drawable/widget_progress" />
    </LinearLayout>
</FrameLayout>
